# Shopify app credentials. `shopify app dev` sets these automatically; set them
# yourself when running the server on a host.

# SHOPIFY_API_KEY: the app's Client ID, from shopify.app.image-alt-fix.toml / the Dev Dashboard.
SHOPIFY_API_KEY="7c3c01f070ba1a78de9671ab45cb8d83"
# VITE_SHOPIFY_API_KEY: same Client ID, built into the page for the App Bridge script tag.
# The client ID is public, so it is safe to ship to the browser.
VITE_SHOPIFY_API_KEY="7c3c01f070ba1a78de9671ab45cb8d83"
# SHOPIFY_API_SECRET: the app's Client Secret, from the Dev Dashboard. Keep this out of source control.
SHOPIFY_API_SECRET="MY_SHOPIFY_CLIENT_SECRET"
# SCOPES: must match [access_scopes] in shopify.app.image-alt-fix.toml.
SCOPES="read_products,write_files"

# DATABASE_PATH: SQLite file for shop access tokens. In production, point this at a
# persistent volume. Defaults to ./data/app.sqlite.
# DATABASE_PATH="/data/app.sqlite"

# PORT: port the server listens on. Hosts usually set this. Defaults to 3000.
# PORT=3000
