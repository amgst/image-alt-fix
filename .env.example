# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Shopify OAuth (required to load real store data instead of the demo catalog) ---
# SHOPIFY_API_KEY: the app's Client ID, from shopify.app.wbify-image-seo.toml / the Partner Dashboard.
SHOPIFY_API_KEY="da401c99e22fe6531a3b8033336a992f"
# VITE_SHOPIFY_API_KEY: same Client ID, exposed to the browser build for the App Bridge script tag
# (the client ID is public, not a secret — safe to ship client-side).
VITE_SHOPIFY_API_KEY="da401c99e22fe6531a3b8033336a992f"
# SHOPIFY_API_SECRET: the app's Client Secret, from the Partner/Dev Dashboard. Keep this out of source control.
SHOPIFY_API_SECRET="MY_SHOPIFY_CLIENT_SECRET"
# SCOPES: must match shopify.app.wbify-image-seo.toml's [access_scopes].
SCOPES="read_products,write_products,read_files,write_files"
# SHOPIFY_APP_URL: must match shopify.app.wbify-image-seo.toml's application_url.
SHOPIFY_APP_URL="http://localhost:3000"
